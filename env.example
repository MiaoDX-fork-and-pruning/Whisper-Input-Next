# ===========================================
# Whisper-Input-Next 环境变量配置模板
# 复制此文件为 .env 并填入您的实际配置
# ===========================================

# ===== 服务平台配置 =====
# 推荐使用双平台配置（我们主要维护的配置）
SERVICE_PLATFORM=openai&local

# ===== OpenAI 配置 (必需) =====
# OpenAI GPT-4o transcribe API密钥
OFFICIAL_OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ===== 豆包流式 ASR 配置 =====
TRANSCRIPTION_SERVICE=doubao
# 官方文档: https://www.volcengine.com/docs/6561/1354869?lang=zh
# 新版控制台 API Key（推荐）。填入实际 Key 值，不是控制台里的名称。
DOUBAO_API_KEY=
# 旧版控制台兼容配置；新版可留空。
DOUBAO_APP_KEY=
DOUBAO_ACCESS_KEY=
# 仅支持 ASR 2.0。小时版: volc.seedasr.sauc.duration，并发版: volc.seedasr.sauc.concurrent
DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration
# ASR 2.0 推荐使用 200；留空会自动使用 200
DOUBAO_SSD_VERSION=
# 二遍识别默认开启，提升最终质量；需要更低停止延迟时可改为 false。
DOUBAO_ENABLE_NONSTREAM=true

# ===== 本地 Whisper.cpp 配置 =====
# whisper.cpp 可执行文件路径 (需要先安装 whisper.cpp)
WHISPER_CLI_PATH=/path/to/whisper.cpp/build/bin/whisper-cli
# whisper 模型路径 (相对于whisper.cpp根目录)
WHISPER_MODEL_PATH=models/ggml-large-v3.bin

# ===== 键盘快捷键配置 =====
# 转录快捷键 (Ctrl+F)
TRANSCRIPTIONS_BUTTON=f
# 快捷键修饰键；Linux 可设置为 win 或 super 使用 Win/Super+F
TRANSLATIONS_BUTTON=ctrl
# 系统平台 (mac/linux/win)，用于选择默认粘贴快捷键
SYSTEM_PLATFORM=mac
# 可选：覆盖默认粘贴快捷键。默认 mac=cmd+v, linux=ctrl+shift+v, win=ctrl+v
# PASTE_HOTKEY=ctrl+v

# ===== 功能开关 =====
# 是否转换为简体中文
CONVERT_TO_SIMPLIFIED=false
# 是否自动添加标点符号
ADD_SYMBOL=false
# 是否优化结果
OPTIMIZE_RESULT=false
# 是否启用Kimi润色功能 (已废弃，推荐关闭)
ENABLE_KIMI_POLISH=false
# 自动重试次数（OpenAI/翻译）
AUTO_RETRY_LIMIT=5

# ===== 状态栏图标自定义（可选） =====
# 图标文件支持 PNG/PDF，默认使用 assets/icons/idle.png 等
# STATUS_ICON_IDLE=/path/to/Whisper-Input-Next/Whisper-Input-Next/assets/icons/idle.png
# STATUS_ICON_RECORDING=/path/to/Whisper-Input-Next/Whisper-Input-Next/assets/icons/recording.png
# STATUS_ICON_PROCESSING=/path/to/Whisper-Input-Next/Whisper-Input-Next/assets/icons/transcripting.png

# STATUS_ICON_TEMPLATE=true

# ===== 兼容性配置 (仅作兼容保留) =====
# 以下配置仅作兼容性保留，推荐使用上面的 openai&local 配置

# GROQ 配置 (兼容保留)
# GROQ_API_KEY=your-groq-api-key-here

# SiliconFlow 配置 (兼容保留)  
# SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# Kimi 配置 (已废弃)
# KIMI_API_KEY=your-kimi-api-key-here
# KIMI_BASE_URL=https://api.moonshot.cn/v1
